define_attribute {p:cmos1_pclk} {PAP_IO_LOC} {T12}
define_attribute {p:cmos1_pclk} {PAP_IO_STANDARD} {LVCMOS12}
define_attribute {p:d} {PAP_IO_LOC} {T11}
