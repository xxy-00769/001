define_attribute {p:sys_clk} {PAP_IO_LOC} {P20}
create_clock -name sys_clk [get_ports sys_clk] -period 20
create_clock -name eth2_rxc [get_ports rgmii2_rxc] -period 8
set_clock_groups -asynchronous -group [get_clocks sys_clk]
set_input_delay -clock [get_clocks {eth2_rxc}] -max 2.800 [get_ports {rgmii2_rxd[*] rgmii2_rx_ctl}]
set_input_delay -clock [get_clocks {eth2_rxc}] -min 1.200 [get_ports {rgmii2_rxd[*] rgmii2_rx_ctl}]
set_input_delay -clock [get_clocks {eth2_rxc}] -clock_fall -add_delay -max 2.800 [get_ports {rgmii2_rxd[*] rgmii2_rx_ctl}]
set_input_delay -clock [get_clocks {eth2_rxc}] -clock_fall -add_delay -min 1.200 [get_ports {rgmii2_rxd[*] rgmii2_rx_ctl}]
define_attribute {p:sys_clk} {PAP_IO_VCCIO} {3.3}
define_attribute {p:sys_clk} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:sys_clk} {PAP_IO_DIRECTION} {INPUT}

define_attribute {p:rgmii2_rx_ctl} {PAP_IO_IN_DELAY} {15}
define_attribute {p:rgmii2_rxd[0]} {PAP_IO_IN_DELAY} {15}
define_attribute {p:rgmii2_rxd[1]} {PAP_IO_IN_DELAY} {15}
define_attribute {p:rgmii2_rxd[2]} {PAP_IO_IN_DELAY} {15}
define_attribute {p:rgmii2_rxd[3]} {PAP_IO_IN_DELAY} {15}
set_clock_uncertainty 0.200 [get_clocks eth2_rxc] -setup -hold


set_clock_groups -name eth2_async -asynchronous -group [get_clocks -include_generated_clocks {eth2_rxc}]
