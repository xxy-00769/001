define_attribute {p:rgmii2_rxd[2]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rgmii2_rxd[2]} {PAP_IO_NONE} {TRUE}
define_attribute {p:rgmii2_rxd[3]} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:rgmii2_rxd[3]} {PAP_IO_LOC} {F18}
define_attribute {p:rgmii2_rxd[3]} {PAP_IO_VCCIO} {3.3}
