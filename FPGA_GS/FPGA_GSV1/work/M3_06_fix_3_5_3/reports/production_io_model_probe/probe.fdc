define_attribute {p:rgmii2_rxd[3]} {PAP_IO_NONE} {TRUE}
define_attribute {p:rgmii2_txc} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:rgmii2_txc} {PAP_IO_LOC} {C20}
define_attribute {p:rgmii2_txc} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rgmii2_txc} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rgmii2_txc} {PAP_IO_NONE} {TRUE}
define_attribute {p:rgmii2_txc} {PAP_IO_DRIVE} {24}
define_attribute {p:rgmii2_txc} {PAP_IO_SLEW} {FAST}
define_attribute {p:rgmii2_tx_ctl} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:rgmii2_tx_ctl} {PAP_IO_LOC} {F22}
define_attribute {p:rgmii2_tx_ctl} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rgmii2_tx_ctl} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rgmii2_tx_ctl} {PAP_IO_NONE} {TRUE}
define_attribute {p:rgmii2_tx_ctl} {PAP_IO_DRIVE} {24}
define_attribute {p:rgmii2_tx_ctl} {PAP_IO_SLEW} {FAST}
define_attribute {p:rgmii2_txd[0]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:rgmii2_txd[0]} {PAP_IO_LOC} {C22}
define_attribute {p:rgmii2_txd[0]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rgmii2_txd[0]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rgmii2_txd[0]} {PAP_IO_NONE} {TRUE}
define_attribute {p:rgmii2_txd[0]} {PAP_IO_DRIVE} {24}
define_attribute {p:rgmii2_txd[0]} {PAP_IO_SLEW} {FAST}
define_attribute {p:rgmii2_txd[1]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:rgmii2_txd[1]} {PAP_IO_LOC} {E20}
define_attribute {p:rgmii2_txd[1]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rgmii2_txd[1]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rgmii2_txd[1]} {PAP_IO_NONE} {TRUE}
define_attribute {p:rgmii2_txd[1]} {PAP_IO_DRIVE} {24}
define_attribute {p:rgmii2_txd[1]} {PAP_IO_SLEW} {FAST}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_LOC} {E22}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_NONE} {TRUE}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_DRIVE} {24}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_SLEW} {FAST}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_LOC} {F21}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_NONE} {TRUE}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_DRIVE} {24}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_SLEW} {FAST}
define_attribute {p:rgmii2_rx_ctl} {PAP_IO_IN_DELAY} {15}
define_attribute {p:rgmii2_rxd[0]} {PAP_IO_IN_DELAY} {15}
define_attribute {p:rgmii2_rxd[1]} {PAP_IO_IN_DELAY} {15}
define_attribute {p:rgmii2_rxd[2]} {PAP_IO_IN_DELAY} {15}
define_attribute {p:rgmii2_rxd[3]} {PAP_IO_IN_DELAY} {15}
# Port2 has its own clock. PHY internal RX/TX delay configured by MDIO.
create_clock -name eth2_rxc [get_ports {rgmii2_rxc}] -period 8.000 -waveform {0 4}
set_clock_uncertainty 0.200 [get_clocks {eth2_rxc}] -setup -hold
set_clock_groups -name eth2_async -asynchronous -group [get_clocks -include_generated_clocks {eth2_rxc}]
# RTL8211E table65: TsetupT/TholdT >=1.2ns at PHY output with
# integrated RXC delay. DDR next data transition is [1.2,2.8]ns
# after each delayed RXC edge (8ns period, 4ns half-period).
# PCB differential skew is not included; external electrical signoff pending.
set_input_delay -clock [get_clocks {eth2_rxc}] -max 2.800 [get_ports {rgmii2_rxd[*] rgmii2_rx_ctl}]
set_input_delay -clock [get_clocks {eth2_rxc}] -min 1.200 [get_ports {rgmii2_rxd[*] rgmii2_rx_ctl}]
set_input_delay -clock [get_clocks {eth2_rxc}] -clock_fall -add_delay -max 2.800 [get_ports {rgmii2_rxd[*] rgmii2_rx_ctl}]
set_input_delay -clock [get_clocks {eth2_rxc}] -clock_fall -add_delay -min 1.200 [get_ports {rgmii2_rxd[*] rgmii2_rx_ctl}]

# Pad delay required by pin-local IDES4 hold checks, not a timing exception.
define_attribute {p:rgmii2_rx_ctl} {PAP_IO_IN_DELAY} {15}
define_attribute {p:rgmii2_rxd[0]} {PAP_IO_IN_DELAY} {15}
define_attribute {p:rgmii2_rxd[1]} {PAP_IO_IN_DELAY} {15}
define_attribute {p:rgmii2_rxd[2]} {PAP_IO_IN_DELAY} {15}
define_attribute {p:rgmii2_rxd[3]} {PAP_IO_IN_DELAY} {15}


# Port2 TX MODEL AUDIT / NOT EXTERNAL SIGNOFF.
# Forwarded TXC propagation is retained. TXDLY=2ns is nominal only (RTL8211E
# rev1.6 table3); its PVT limits and the delay-enabled pin-level acceptance
# window are not specified in the supplied document. Table65's 1ns setup/
# hold remains unchanged; it must not be presented as an intrinsic flop spec.
# Remove the unsubstantiated symmetric 0.3ns "link skew" allocation. Instead
# explicitly cover the documented Duty_G=45..55%: with this 8ns DDR source,
# the next data transition can be 0.4ns sooner on either capture edge. Setup
# uses the same source edge and does not incur this half-cycle shortening.
# No PCB skew / PHY-delay PVT measurement is implied. Release remains gated
# pending a bounded external model; even this nominal-delay model fails hold.
create_generated_clock -name eth2_phy_tx_capture -source [get_ports {rgmii2_rxc}] -master_clock [get_clocks {eth2_rxc}] -edges {1 2 3} -edge_shift {2.000 2.000 2.000} [get_ports {rgmii2_txc}]
set_clock_uncertainty 0.000 -from [get_clocks {eth2_rxc}] -to [get_clocks {eth2_phy_tx_capture}] -setup
set_clock_uncertainty 0.400 -from [get_clocks {eth2_rxc}] -to [get_clocks {eth2_phy_tx_capture}] -hold
set_output_delay -clock [get_clocks {eth2_phy_tx_capture}] -max 1.000 [get_ports {rgmii2_txd[*] rgmii2_tx_ctl}]
set_output_delay -clock [get_clocks {eth2_phy_tx_capture}] -min -1.000 [get_ports {rgmii2_txd[*] rgmii2_tx_ctl}]
set_output_delay -clock [get_clocks {eth2_phy_tx_capture}] -clock_fall -add_delay -max 1.000 [get_ports {rgmii2_txd[*] rgmii2_tx_ctl}]
set_output_delay -clock [get_clocks {eth2_phy_tx_capture}] -clock_fall -add_delay -min -1.000 [get_ports {rgmii2_txd[*] rgmii2_tx_ctl}]
