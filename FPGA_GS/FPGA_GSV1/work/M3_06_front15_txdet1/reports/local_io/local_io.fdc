define_attribute {p:rgmii2_txd[1]} {PAP_IO_DRIVE} {12}
define_attribute {p:rgmii2_txd[1]} {PAP_IO_SLEW} {FAST}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_LOC} {E22}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_NONE} {TRUE}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_DRIVE} {12}
define_attribute {p:rgmii2_txd[2]} {PAP_IO_SLEW} {FAST}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_LOC} {F21}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_NONE} {TRUE}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_DRIVE} {12}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_SLEW} {FAST}
create_clock -name eth2_rxc [get_ports {rgmii2_rxc}] -period 8.000 -waveform {0 4}
set_clock_uncertainty 0.200 [get_clocks {eth2_rxc}] -setup -hold
# TXDET1: coedge launch from PLL OUT0/global nc; PHY override TX=1 RX=1.
# Actual forwarded TXC is at phase 4ns. Internal PHY TX delay nominal 2ns.
# Receiver setup/hold remain 1ns (RTL8211E table65). Subtract the PHY
# delay from output delays: max=1-2=-1; min=-1-2=-3. Both DDR edges.
# PHY delay PVT and PCB skew remain separately declared external limits,
# not measured guarantees. Common-clock PLL input jitter is correlated;
# explicit relative 0.1ns budget is applied to the capture clock below.
create_generated_clock -name eth2_phy_tx_capture -source [get_ports {rgmii2_rxc}] -master_clock [get_clocks {eth2_rxc}] -edges {1 2 3} -edge_shift {4.000 4.000 4.000} [get_ports {rgmii2_txc}]
set_clock_uncertainty 0.100 -setup -hold [get_clocks {eth2_phy_tx_capture}]
set_output_delay -clock [get_clocks {eth2_phy_tx_capture}] -max -1.000 [get_ports {rgmii2_txd[*] rgmii2_tx_ctl}]
set_output_delay -clock [get_clocks {eth2_phy_tx_capture}] -min -3.000 [get_ports {rgmii2_txd[*] rgmii2_tx_ctl}]
set_output_delay -clock [get_clocks {eth2_phy_tx_capture}] -clock_fall -add_delay -max -1.000 [get_ports {rgmii2_txd[*] rgmii2_tx_ctl}]
set_output_delay -clock [get_clocks {eth2_phy_tx_capture}] -clock_fall -add_delay -min -3.000 [get_ports {rgmii2_txd[*] rgmii2_tx_ctl}]
# Forced RXID: PHY output setup/hold >=1.2ns, 4ns DDR half period.
set_input_delay -clock [get_clocks {eth2_rxc}] -min 1.200 [get_ports {rgmii2_rxd[*] rgmii2_rx_ctl}]
set_input_delay -clock [get_clocks {eth2_rxc}] -max 2.800 [get_ports {rgmii2_rxd[*] rgmii2_rx_ctl}]
set_input_delay -clock [get_clocks {eth2_rxc}] -clock_fall -add_delay -min 1.200 [get_ports {rgmii2_rxd[*] rgmii2_rx_ctl}]
set_input_delay -clock [get_clocks {eth2_rxc}] -clock_fall -add_delay -max 2.800 [get_ports {rgmii2_rxd[*] rgmii2_rx_ctl}]
