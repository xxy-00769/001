define_attribute {p:data[2]} {PAP_IO_DRIVE} {24}
define_attribute {p:data[2]} {PAP_IO_SLEW} {FAST}
define_attribute {p:data[3]} {PAP_IO_DIRECTION} {OUTPUT}
