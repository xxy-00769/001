define_attribute {p:rgmii2_txd[3]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_LOC} {F21}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_NONE} {TRUE}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_DRIVE} {12}
define_attribute {p:rgmii2_txd[3]} {PAP_IO_SLEW} {FAST}
create_clock -name eth2_rxc [get_ports {rgmii2_rxc}] -period 8.000 -waveform {0 4}
set_clock_uncertainty 0.200 [get_clocks {eth2_rxc}] -setup -hold
# TXDET1: coedge data/control/TXC launch from the same PLL OUT0/global nc.
# PHY register override supplies nominal +2ns TX delay, RX delay enabled.
# Receiver sampling clock = actual forwarded phase4 TXC + PHY nominal2.
# The clock at the TXC constraint anchor represents the INTERNAL PHY capture
# point, not the voltage edge on the pad. The physical clock path is traced
# through OUT0/BUFG/ODDR/OBUF once; only the ideal edge includes PHY +2ns.
# Keep receiver setup/hold each 1ns; both DDR edges. No negative-delay
# coedge exception/multicycle is used. The tool PLL relative uncertainty
#0.05ns remains. The initial extra0.1ns had no device/source specification;
# it was a separately declared design reserve, not a receiver requirement.
# Shared OUT0 removes independent-PLL-output phase uncertainty. Actual
# remaining slack is reported as reserve, not consumed by an invented jitter.
# PHY delay PVT/PCB mismatch are not measured or guaranteed by this model.
create_generated_clock -name eth2_phy_tx_capture -source [get_ports {rgmii2_rxc}] -master_clock [get_clocks {eth2_rxc}] -edges {1 2 3} -edge_shift {6.000 6.000 6.000} [get_ports {rgmii2_txc}]
set_output_delay -clock [get_clocks {eth2_phy_tx_capture}] -max 1.000 [get_ports {rgmii2_txd[*] rgmii2_tx_ctl}]
set_output_delay -clock [get_clocks {eth2_phy_tx_capture}] -min -1.000 [get_ports {rgmii2_txd[*] rgmii2_tx_ctl}]
set_output_delay -clock [get_clocks {eth2_phy_tx_capture}] -clock_fall -add_delay -max 1.000 [get_ports {rgmii2_txd[*] rgmii2_tx_ctl}]
set_output_delay -clock [get_clocks {eth2_phy_tx_capture}] -clock_fall -add_delay -min -1.000 [get_ports {rgmii2_txd[*] rgmii2_tx_ctl}]
