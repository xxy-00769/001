# Official demo had no timing constraints. E1 declares real source clocks,
# retains inferred PLL phases, and checks all synchronous internal paths.
create_clock -name sys50 -period 20.000 [get_ports {clk_50m}]
create_clock -name phy_rxc -period 8.000 [get_ports {rgmii_rxc}]
set_clock_uncertainty 0.200 [get_clocks {sys50 phy_rxc}] -setup -hold
# Independent oscillators. The only logical crossings are reset/lock signals;
# mac reset uses async assertion plus three-clock release synchronization.
set_clock_groups -asynchronous -group [get_clocks {sys50}] -group [get_clocks {phy_rxc}]
# External PHY/PCB timing is NOT signed off by this baseline constraint file.
# Do not infer board-level setup/hold pass from the internal timing summary.
# RX/TX IO eye assumptions are reported separately, not hidden false paths.
define_attribute {p:net1_rxc} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:net1_rxc} {PAP_IO_LOC} {F14}
define_attribute {p:net1_rxc} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {i:ddr0.u_pll_e3} {PAP_LOC} {PLL_158_199}
define_attribute {i:ddr1.u_pll_e3} {PAP_LOC} {PLL_158_179}
define_attribute {i:display_pll.u_pll_e3} {PAP_LOC} {PLL_158_55}
define_attribute {i:port1_pll.u_pll_e3} {PAP_LOC} {PLL_158_303}
define_attribute {i:port2_pll.u_pll_e3} {PAP_LOC} {PLL_158_75}
create_clock -name net1 -period 8 [get_ports {net1_rxc}]
create_generated_clock -name cfg10 -source [get_ports {clk_50m}] -edges {1 5 11} [get_nets {refs.cfg_clk}]
create_generated_clock -name cam25 -source [get_ports {clk_50m}] -divide_by 2 [get_nets {refs.camera_clk}]
define_attribute {p:net1_rxc} {PAP_IO_VCCIO} {3.3}
