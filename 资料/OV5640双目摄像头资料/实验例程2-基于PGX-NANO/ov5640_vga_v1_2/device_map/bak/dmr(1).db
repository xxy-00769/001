    <general_container id="device_map_timing_constraint">
        <table_container>
            <table id="device_map_timing_constraint" title="Timing Constraint" column_number="1">
                <column_headers>
                    <data>Command</data>
                </column_headers>
                <row>
                    <data>create_clock -name {sys_clk} [get_ports {sys_clk}] -period {20.000} -waveform {0.000 10.000}</data>
                </row>
                <row>
                    <data>create_clock -name {coms1_pclk} [get_ports {cmos1_pclk}] -period {10.42} -waveform {0.000 5.950}</data>
                </row>
                <row>
                    <data>create_clock -name {coms2_pclk} [get_ports {cmos2_pclk}] -period {10.420} -waveform {0.000 5.950}</data>
                </row>
            </table>
        </table_container>
        <table_container>
            <table id="device_map_timing_constraint" title="Inferred clocks commands" column_number="1">
                <column_headers>
                    <data>Command</data>
                </column_headers>
                <row>
                    <data>create_generated_clock -name {sys_clk|u_pll/u_gpll/CLKOUT1_Inferred} -master_clock {sys_clk} -source [get_ports {sys_clk}] -edges {1 2 3} -edge_shift {0.000000 9.840000 19.680000} [get_pins {u_pll/u_gpll.CLKOUT1}] -add</data>
                </row>
                <row>
                    <data>create_generated_clock -name {sys_clk|u_pll/u_gpll/CLKOUT0_Inferred} -master_clock {sys_clk} -source [get_ports {sys_clk}] -edges {1 2 3} -edge_shift {0.000000 10.000000 20.000000} [get_pins {u_pll/u_gpll.CLKOUT0}] -add</data>
                </row>
            </table>
        </table_container>
    </general_container>
